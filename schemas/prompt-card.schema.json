{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gordo-v1su4/directors-cut/schemas/prompt-card.schema.json",
  "title": "Directors Cut Prompt Card",
  "description": "Permissive v1 schema for Markdown prompt-card YAML frontmatter. Markdown body sections are validated by content review, not this schema.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "model_family",
    "evidence_type",
    "library_status",
    "tags",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "repo_scope": {
      "type": "string"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "prompt_card",
        "prompt_pack",
        "comparison_result",
        "workflow_setup"
      ]
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string"
    },
    "curator": {
      "type": "string"
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "model_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_mode": {
      "type": "string"
    },
    "output_shape": {
      "type": "string"
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aspect_ratio": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_seconds": {
      "type": [
        "number",
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "speculative"
      ]
    },
    "source_count": {
      "type": [
        "integer",
        "number"
      ],
      "minimum": 0
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "library_status": {
      "type": "string",
      "minLength": 1
    },
    "tested_by_us": {
      "type": "boolean"
    },
    "test_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "human_rating": {
      "type": "object",
      "additionalProperties": true
    },
    "prompt_pattern": {
      "type": "string",
      "description": "Extracted template prompt pattern from the card body."
    },
    "generation_prompts": {
      "type": "array",
      "description": "References to concrete prompts generated from this card (e.g. image grids, videos).",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "prompt_id": { "type": "string" },
          "model": { "type": "string" },
          "provider": { "type": "string" },
          "slot_type": { "type": "string" },
          "created_at": { "type": "string" }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
