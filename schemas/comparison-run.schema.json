{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://directors-cut.example/schemas/comparison-run.schema.json",
  "title": "Directors Cut Comparison Run",
  "description": "YAML frontmatter schema for a multi-agent/multi-model comparison run.",
  "type": "object",
  "required": ["run_id", "title", "question", "created", "status", "models_requested", "target_models"],
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^dc-compare-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$",
      "description": "Stable run identifier, e.g. dc-compare-2026-07-02-001."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Short human-readable title for the comparison."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "Exact creative question asked of every agent/model."
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "ISO-8601 date the run was created."
    },
    "created_by": {
      "type": "string",
      "enum": ["hermes", "omp", "gordo", "raycast", "kimi"],
      "description": "Who initiated the comparison."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "running", "answers_collected", "graded", "promoted"],
      "description": "Lifecycle status of the run."
    },
    "models_requested": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of agents/models asked to answer."
    },
    "target_models": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Video models the answers are ultimately targeting, e.g. Seedance 2.0, Sora."
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": true
      },
      "description": "Reference videos or links used to frame the comparison."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Searchable tags."
    }
  }
}
