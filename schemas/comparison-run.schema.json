{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gordo-v1su4/directors-cut/schemas/comparison-run.schema.json",
  "title": "Directors Cut Comparison Run",
  "description": "Permissive v1 schema for comparisons/<run-id>/run.md frontmatter.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "title",
    "question",
    "created",
    "created_by",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "running",
        "answers_partial",
        "answers_collected",
        "concepts_approved",
        "generation_partial",
        "partially_generated",
        "ready_for_review",
        "graded",
        "promoted"
      ]
    },
    "models_requested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
