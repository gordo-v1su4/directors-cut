{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://directors-cut.example/schemas/model-answer.schema.json",
  "title": "Directors Cut Model Answer",
  "description": "JSON schema for a single answer in a comparison run (answers.jsonl line shape).",
  "type": "object",
  "required": ["answer_id", "run_id", "agent_name", "model_name", "model_class", "target_model", "prompt_mode", "answer_text", "created_at", "source"],
  "additionalProperties": true,
  "properties": {
    "answer_id": {
      "type": "string",
      "pattern": "^ans-[0-9]{3}$",
      "description": "Short stable answer id within the run, e.g. ans-001."
    },
    "run_id": {
      "type": "string",
      "pattern": "^dc-compare-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$",
      "description": "Parent comparison run id."
    },
    "agent_name": {
      "type": "string",
      "description": "Name of the agent/subagent that produced the answer, e.g. Seedance Director Agent."
    },
    "model_name": {
      "type": "string",
      "description": "Exact model name used, e.g. raycast-standard-latest, gpt-5.5, kimi-k2-7."
    },
    "model_class": {
      "type": "string",
      "enum": ["raycast_standard", "raycast_advanced", "openai", "anthropic", "google", "xai", "kimi", "local", "hermes_skill"],
      "description": "Broad provider/model class for filtering and cost tracking."
    },
    "target_model": {
      "type": "string",
      "description": "Video model the answer is meant for, e.g. Seedance 2.0, Sora."
    },
    "prompt_mode": {
      "type": "string",
      "enum": ["seedance_director", "seedance_json_en_zh", "teaser_trailer_screenplay", "sora_freeform", "comparison_question"],
      "description": "Prompting style the answer was generated with."
    },
    "answer_text": {
      "type": "string",
      "minLength": 1,
      "description": "Raw text of the answer/prompt."
    },
    "structured_prompt": {
      "type": ["object", "null"],
      "description": "Optional parsed structured prompt (JSON, bilingual, etc.)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the answer was produced."
    },
    "tokens_estimated": {
      "type": ["integer", "null"],
      "description": "Estimated token count if available."
    },
    "source": {
      "type": "string",
      "enum": ["raycast", "hermes", "kimi", "local", "manual"],
      "description": "Origin system for the answer."
    },
    "graded": {
      "type": "boolean",
      "description": "Whether this answer has been graded yet."
    },
    "grade": {
      "type": ["object", "null"],
      "description": "Embedded grade object if available.",
      "additionalProperties": true,
      "properties": {
        "grader": { "type": "string" },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "weighted_total": { "type": "number" },
        "class_rank": { "type": "integer" },
        "overall_rank": { "type": "integer" },
        "notes": { "type": "string" },
        "promote_to_card": { "type": "boolean" }
      }
    }
  }
}
