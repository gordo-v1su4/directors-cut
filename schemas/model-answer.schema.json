{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gordo-v1su4/directors-cut/schemas/model-answer.schema.json",
  "title": "Directors Cut Model Answer JSONL Row",
  "description": "Permissive v1 schema for comparisons/<run-id>/answers.jsonl entries.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "answer_id",
    "run_id",
    "agent_name",
    "model_name",
    "target_model",
    "answer_text",
    "created_at",
    "source"
  ],
  "properties": {
    "answer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer_text": {
      "type": "string",
      "minLength": 1
    },
    "structured_prompt": {},
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "tokens_estimated": {
      "type": [
        "integer",
        "number",
        "null"
      ],
      "minimum": 0
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
