{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gordo-v1su4/directors-cut/schemas/prompt-pack.schema.json",
  "title": "Directors Cut Prompt Pack",
  "description": "Permissive v1 schema for grouped prompt cards/packs.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "tags",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string"
    },
    "curator": {
      "type": "string"
    },
    "model_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "library_status": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
