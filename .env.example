# Bridge token for Create automation and Projects quote/generate.
# Copy to .env.local (not committed).

# The app always uses the live media catalog; no catalog override is needed.
# Open http://127.0.0.1:5191 (the backend-authorized origin).

VITE_RAYCAST_BRIDGE_URL=http://127.0.0.1:8787
VITE_RAYCAST_BRIDGE_TOKEN=your-bridge-token-here

# Server/worker only; never prefix secrets with VITE_.
MEDIA_GATEWAY_URL=
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_BUCKET=
MEDIA_GATEWAY_USER_ID=
MEDIA_GATEWAY_UPLOAD_PREFIX=
DIRECTORS_CUT_DATABASE=
